#!/bin/sh

source "$(dirname $0)"/common

SYNOPKG_PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/CodecPack/target}"
ACT_DIR="${PKG_PATH}/etc/activation"

# Install activation files
mkdir -p "$ACT_DIR" 2>/dev/null
if [ -d "$ACT_DIR" ]; then
    cp "$SYNOPKG_PKGDEST/activation/activation.conf" "$ACT_DIR/" 2>/dev/null
    cp "$SYNOPKG_PKGDEST/activation/offline_license.json" "$ACT_DIR/" 2>/dev/null
    echo "Activation files installed to $ACT_DIR"
else
    echo "Could not create $ACT_DIR — run manually:"
    echo "  sudo mkdir -p $ACT_DIR && sudo cp $SYNOPKG_PKGDEST/activation/* $ACT_DIR/"
fi

# Set codec pack status to installed (codecs are pre-bundled)
SetPackStatus installed

# --- /usr/syno/bin/ffmpeg-thumb ---------------------------------------
# synothumb / synomkthumbd / synomkflvd / synoflvconv also call this path.
# It is root-owned, and DSM refuses to run package scripts as root unless the
# SPK is signed, so the package can only report the problem and remember the
# previous value (used by preuninst to print the restore command).
THUMB=/usr/syno/bin/ffmpeg-thumb
THUMB_TARGET="/var/packages/CodecPack/target/pack/bin/ffmpeg41"
THUMB_ORIG="$PKG_VAR_PATH/ffmpeg-thumb.orig"

thumb_cur=$(readlink "$THUMB" 2>/dev/null || echo ABSENT)
if [ "$thumb_cur" = "$THUMB_TARGET" ]; then
    echo "ffmpeg-thumb -> CodecPack ffmpeg41 (ok)"
else
    [ -f "$THUMB_ORIG" ] || echo "$thumb_cur" > "$THUMB_ORIG" 2>/dev/null || true
    echo "WARNING: $THUMB points to '${thumb_cur}'."
    echo "         DSM thumbnails will not use this pack's HEVC decoder."
    echo "         Fix once with:"
    echo "           sudo ln -sfn $THUMB_TARGET $THUMB"
fi

# --- pack/usr/bin/convert ---------------------------------------------
# synothumb / synomkthumbd run this for every *image* thumbnail. Official AME
# gets a Synology ImageMagick from the online codec-pack download; we ship a
# shim that borrows the system one. HEIC/HEIF needs the SynoCommunity build
# (linked against libheif); DSM's own /usr/bin/convert decodes JPEG/PNG only.
if [ -x /var/packages/imagemagick/target/bin/magick ]; then
    echo "pack/usr/bin/convert -> ImageMagick (SynoCommunity), HEIC ok"
else
    echo "WARNING: 'imagemagick' package not found."
    echo "         Photo / HEIC thumbnails will fail until it is installed:"
    echo "           Package Center -> imagemagick (SynoCommunity)"
fi

exit 0
