#!/bin/sh
# DSM's synothumb / synomkthumbd / synoflvconv run this for every thumbnail.
# Official AME fills this slot with a Synology ImageMagick delivered by its
# online codec-pack download. A self-assembled pack has to provide it.
#
# synothumb calls ImageMagick in two different argument styles:
#   images : -define registry:...  SRC  -define jpeg:size=... -thumbnail ... OUT
#   videos : -define jpeg:size=... -thumbnail ... -quality ... -type ... IN OUT
# ImageMagick 7 only accepts the second style once an input image exists --
# with "-thumbnail" before the input it dies with "NoImagesFound". DSM's own
# ImageMagick 6 (the one the stock AME pack uses) accepts both.
# HEIC/HEIF/AVIF can only be decoded by the SynoCommunity ImageMagick 7
# (libheif), everything else is safer on IM6 => dispatch by file extension.
for a in "$@"; do
    case "$a" in
        *.heic|*.HEIC|*.heif|*.HEIF|*.avif|*.AVIF)
            exec /var/packages/imagemagick/target/bin/magick "$@" ;;
    esac
done
[ -x /usr/bin/convert ] && exec /usr/bin/convert "$@"
[ -x /var/packages/imagemagick/target/bin/magick ] && exec /var/packages/imagemagick/target/bin/magick "$@"
echo "CodecPack: no ImageMagick found; thumbnails will not work." >&2
exit 127
